{
  "id": "A150",
  "title": "N-01 卡片不出现“骗子、诈骗、同行、竞争对手”等字眼（“了解行情”除外）",
  "type": "lead_matrix",
  "input": {
    "fixture": "card_harbor.json",
    "forbidden_words": ["骗子", "诈骗", "同行", "竞争对手"],
    "cases": [
      { "name": "automated", "form_meta": { "honeypot_triggered": true }, "expect_class": "automated_submission" },
      { "name": "phishing", "signals": ["contains_login_or_download_link"], "expect_class": "phishing_like" },
      { "name": "vendor", "signals": ["offers_sourcing_or_supply"], "expect_class": "vendor_solicitation" },
      { "name": "competitor", "signals": ["asks_customer_or_supplier_list"], "expect_class": "competitor_probe" },
      { "name": "individual", "signals": ["student_or_research_purpose"], "expect_class": "individual_research" },
      { "name": "target", "signals": ["states_end_use_project", "names_product_model"], "expect_class": "target_end_user" },
      { "name": "reseller", "signals": ["mentions_resale_or_distribution", "states_quantity"], "expect_class": "reseller" }
    ]
  },
  "expect": { "all_pass": true }
}