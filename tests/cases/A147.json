      { "name": "individual", "signals": ["student_or_research_purpose"], "expect_class": "individual_research" },
      { "name": "target", "signals": ["states_end_use_project", "states_quantity"], "expect_class": "target_end_user" },
      { "name": "reseller", "signals": ["mentions_own_brand_oem", "names_product_model"], "expect_class": "reseller" },
      { "name": "unknown-only", "signals": ["unknown_signal"], "expect_class": "unclear" }
    ]
  },
