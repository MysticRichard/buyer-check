      { "name": "reseller-oem-qty", "signals": ["mentions_own_brand_oem", "states_quantity"], "expect_class": "reseller" },
      { "name": "unclear-none", "signals": [], "expect_class": "unclear" },
      { "name": "unclear-one-weak", "signals": ["generic_no_product"], "expect_class": "unclear" }
