{
  "id": "A149",
  "title": "N-01 五个非目标类的固定结论句渲染正确；深查≤50 行、快查≤30 行、第一屏≤14 行",
  "type": "lead_matrix",
  "input": {
    "fixture": "card_harbor.json",
    "cases": [
      {
        "name": "automated-submission",
        "form_meta": { "honeypot_triggered": true },
        "expect_class": "automated_submission",
        "expect_conclusion": "这条提交像自动程序发出的，先不回复。",
        "line_count_max": 50,
        "first_screen_max": 14
      },
      {
        "name": "phishing-like",
        "signals": ["contains_login_or_download_link"],
        "expect_class": "phishing_like",
        "expect_conclusion": "询盘里有需登录或下载的内容：先不要打开，用官网公示的渠道确认后再处理。",
        "line_count_max": 50,
        "first_screen_max": 14
      },
      {
        "name": "vendor-solicitation",
        "signals": ["offers_inspection_audit_service"],
        "expect_class": "vendor_solicitation",
        "expect_conclusion": "这更像向你推销服务，不是采购询盘：可以归档。",
        "line_count_max": 50,
        "first_screen_max": 14
      },
      {
        "name": "competitor-probe",
        "signals": ["asks_customer_or_supplier_list"],
        "expect_class": "competitor_probe",
        "expect_conclusion": "这条更像了解行情：只发标准目录和公开价，不发底价和客户信息。",
        "line_count_max": 50,
        "first_screen_max": 14
      },
      {
        "name": "individual-research",
        "signals": ["personal_use_small_qty"],
        "expect_class": "individual_research",
        "expect_conclusion": "看起来是个人或调研需求：低优先级，按标准资料回复即可。",
        "line_count_max": 50,
        "first_screen_max": 14
      },
      {
        "name": "quick-vendor",
        "signals": ["offers_seo_web_marketing"],
        "quick_check": true,
        "expect_class": "vendor_solicitation",
        "line_count_max": 30,
        "first_screen_max": 14
      },
      {
        "name": "quick-phishing",
        "signals": ["contains_attachment_risky_ext"],
        "quick_check": true,
        "expect_class": "phishing_like",
        "line_count_max": 30,
        "first_screen_max": 14
      }
    ]
  },
  "expect": { "all_pass": true }
}